@using S3EnvManager.Sops
@using S3EnvManager.Web.Services

<MudDialog>
	<DialogContent>
		@if (_errorMessage is not null)
		{
			<MudAlert Severity="Severity.Error" Class="mb-2" Dense="true">@_errorMessage</MudAlert>
		}
		<MudStack Spacing="3" Style="min-width: 380px;">
			<MudSelect T="Guid?" @bind-Value="_selectedSharedSecretId"
				@bind-Value:after="OnSharedSecretChanged" Label="공유 시크릿">
				@foreach (var secret in ReferencableSecrets)
				{
					<MudSelectItem T="Guid?" Value="secret.Id">@secret.Name</MudSelectItem>
				}
			</MudSelect>
			<MudTextField T="string" Value="_keyName" ValueChanged="OnKeyNameChanged" Label="이 App에서 쓸 키 이름"
				Validation="@(new Func<string, string?>(SecretKeyNameValidator.Validate))" Immediate="true" />
		</MudStack>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">취소</MudButton>
		<MudButton Color="Color.Primary" OnClick="Submit">추가</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

	[Parameter] public IReadOnlyList<SharedSecretSummary> ReferencableSecrets { get; set; } = [];
	[Parameter] public ISet<string> ExistingKeyNames { get; set; } = new HashSet<string>();

	private Guid? _selectedSharedSecretId;
	private string _keyName = string.Empty;
	private string? _autoFilledKeyName;
	private string? _errorMessage;

	// 공유 시크릿을 고르면 이름을 기본값으로 채워준다 - 사용자가 직접 고친 뒤에는 선택이
	// 바뀌어도 그 값을 덮어쓰지 않는다.
	private void OnSharedSecretChanged()
	{
		var secret = ReferencableSecrets.FirstOrDefault(s => s.Id == _selectedSharedSecretId);
		if (secret is null || (_keyName.Length > 0 && _keyName != _autoFilledKeyName))
		{
			return;
		}
		_keyName = secret.Name;
		_autoFilledKeyName = secret.Name;
	}

	private void OnKeyNameChanged(string value) => _keyName = value;

	private void Submit()
	{
		_errorMessage = null;
		if (_selectedSharedSecretId is null)
		{
			_errorMessage = "공유 시크릿을 선택하세요.";
			return;
		}

		var keyError = SecretKeyNameValidator.Validate(_keyName);
		if (keyError is not null)
		{
			_errorMessage = keyError;
			return;
		}

		if (ExistingKeyNames.Contains(_keyName))
		{
			_errorMessage = $"키 '{_keyName}'가 이미 존재합니다.";
			return;
		}

		MudDialog.Close(DialogResult.Ok((_keyName, _selectedSharedSecretId.Value)));
	}

	private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}
