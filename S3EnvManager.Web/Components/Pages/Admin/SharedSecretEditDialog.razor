@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using S3EnvManager.Web.Services

@inject ISharedSecretService SharedSecretService
@inject ISnackbar Snackbar

<MudDialog>
	<DialogContent>
		@if (_errorMessage is not null)
		{
			<MudAlert Severity="Severity.Error" Class="mb-2">@_errorMessage</MudAlert>
		}
		<MudStack Spacing="3" Style="min-width: 420px;">
			<MudTextField T="string" @bind-Value="_name" Label="이름" Disabled="!IsNew" Immediate="true" />
			<MudTextField T="string" @bind-Value="_description" Label="설명(선택)" Immediate="true" />
			<MudTextField T="string" @bind-Value="_value" Label="값" Lines="4"
				Variant="Variant.Outlined" Style="font-family: monospace;" />
			<MudDatePicker @bind-Date="_expiresAt" Label="만료일(선택)" Clearable="true" />
		</MudStack>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">취소</MudButton>
		<MudButton Color="Color.Primary" OnClick="SubmitAsync" Disabled="_saving">
			@(_saving ? "저장 중..." : "저장")
		</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
	[CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

	[Parameter] public bool IsNew { get; set; }
	[Parameter] public Guid SecretId { get; set; }
	[Parameter] public string Name { get; set; } = string.Empty;
	[Parameter] public string? Description { get; set; }
	[Parameter] public string Value { get; set; } = string.Empty;
	[Parameter] public DateTime? ExpiresAt { get; set; }

	private string _name = string.Empty;
	private string? _description;
	private string _value = string.Empty;
	private DateTime? _expiresAt;
	private bool _saving;
	private string? _errorMessage;

	protected override void OnInitialized()
	{
		_name = Name;
		_description = Description;
		_value = Value;
		_expiresAt = ExpiresAt;
	}

	private async Task<string?> GetCurrentUserIdAsync()
	{
		if (AuthenticationStateTask is null)
		{
			return null;
		}
		var state = await AuthenticationStateTask;
		return state.User.FindFirstValue(ClaimTypes.NameIdentifier);
	}

	private async Task SubmitAsync()
	{
		_errorMessage = null;
		if (IsNew && string.IsNullOrWhiteSpace(_value))
		{
			_errorMessage = "값을 입력하세요.";
			return;
		}

		_saving = true;
		try
		{
			var actorUserId = await GetCurrentUserIdAsync();
			var expiresAtOffset = _expiresAt.HasValue
				? new DateTimeOffset(_expiresAt.Value.Date, TimeSpan.Zero)
				: (DateTimeOffset?)null;

			if (IsNew)
			{
				await SharedSecretService.CreateAsync(
					_name, _description, _value, expiresAtOffset, actorUserId);
			}
			else
			{
				// 값을 실제로 바꿨을 때만 재전파(cascade)를 트리거한다 - 설명/만료일만 바꾼
				// 경우까지 모든 참조 App에 재저장을 걸 필요는 없다.
				var newValue = _value == Value ? null : _value;
				await SharedSecretService.UpdateAsync(
					SecretId, _description, newValue, expiresAtOffset, actorUserId);
			}

			MudDialog.Close(DialogResult.Ok(true));
		}
		catch (Exception ex)
		{
			_errorMessage = $"저장에 실패했습니다: {ex.Message}";
		}
		finally
		{
			_saving = false;
		}
	}

	private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}
