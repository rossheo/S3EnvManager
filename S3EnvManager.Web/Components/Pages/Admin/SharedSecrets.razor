@page "/admin/shared-secrets"
@rendermode InteractiveServer
@attribute [Authorize(Roles = IdentityRoleNames.Administrator)]

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using S3EnvManager.Database
@using S3EnvManager.Web.Services

@inject ISharedSecretService SharedSecretService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@inject IDialogService DialogService

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>공유 시크릿</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">공유 시크릿</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
	여러 App이 공유하는 시크릿(외부 API 키 등)을 한 번만 등록하면, 허가된 App만 이름으로
	참조해서 쓸 수 있습니다. 값을 갱신하면 참조하는 모든 App에 자동으로 전파됩니다.
</MudText>

@if (_secrets is null)
{
	<MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
	<MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4" OnClick="OpenCreateDialogAsync">
		새 공유 시크릿 등록
	</MudButton>

	@if (_secrets.Count == 0)
	{
		<MudText Typo="Typo.body2">등록된 공유 시크릿이 없습니다.</MudText>
	}
	else
	{
		<MudTable Items="_secrets" Hover="true" Elevation="0">
			<HeaderContent>
				<MudTh>이름</MudTh>
				<MudTh>설명</MudTh>
				<MudTh>만료일</MudTh>
				<MudTh>최종 수정</MudTh>
				<MudTh></MudTh>
			</HeaderContent>
			<RowTemplate>
				<MudTd DataLabel="이름">@context.Name</MudTd>
				<MudTd DataLabel="설명">@context.Description</MudTd>
				<MudTd DataLabel="만료일">
					@(context.ExpiresAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")
				</MudTd>
				<MudTd DataLabel="최종 수정">@context.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
				<MudTd>
					<MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mr-1"
						OnClick="@(() => OpenEditDialogAsync(context.Id))">
						편집
					</MudButton>
					<MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
						Class="mr-1" OnClick="@(() => OpenGrantDialogAsync(context.Id))">
						그랜트 관리
					</MudButton>
					<MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
						OnClick="@(() => DeleteAsync(context.Id, context.Name))">
						삭제
					</MudButton>
				</MudTd>
			</RowTemplate>
		</MudTable>
	}
}

@code {
	[CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

	private List<SharedSecretSummary>? _secrets;

	protected override async Task OnInitializedAsync()
	{
		await ReloadAsync();
	}

	private async Task ReloadAsync()
	{
		_secrets = await SharedSecretService.ListAsync();
	}

	private async Task<string?> GetCurrentUserIdAsync()
	{
		if (AuthenticationStateTask is null)
		{
			return null;
		}
		var state = await AuthenticationStateTask;
		return state.User.FindFirstValue(ClaimTypes.NameIdentifier);
	}

	private async Task OpenCreateDialogAsync()
	{
		var parameters = new DialogParameters<SharedSecretEditDialog>
		{
			{ x => x.IsNew, true },
		};
		var dialog = await DialogService.ShowAsync<SharedSecretEditDialog>("새 공유 시크릿 등록", parameters);
		var result = await dialog.Result;
		if (result is { Canceled: false })
		{
			await ReloadAsync();
		}
	}

	private async Task OpenEditDialogAsync(Guid id)
	{
		var detail = await SharedSecretService.LoadForEditAsync(id);
		var parameters = new DialogParameters<SharedSecretEditDialog>
		{
			{ x => x.IsNew, false },
			{ x => x.SecretId, detail.Id },
			{ x => x.Name, detail.Name },
			{ x => x.Description, detail.Description },
			{ x => x.Value, detail.Value },
			{ x => x.ExpiresAt, detail.ExpiresAt?.LocalDateTime },
		};
		var dialog = await DialogService.ShowAsync<SharedSecretEditDialog>("공유 시크릿 편집", parameters);
		var result = await dialog.Result;
		if (result is { Canceled: false })
		{
			await ReloadAsync();
		}
	}

	private async Task OpenGrantDialogAsync(Guid id)
	{
		var parameters = new DialogParameters<SharedSecretGrantDialog>
		{
			{ x => x.SharedSecretId, id },
		};
		await DialogService.ShowAsync<SharedSecretGrantDialog>("그랜트 관리", parameters);
	}

	private async Task DeleteAsync(Guid id, string name)
	{
		var confirmed = await JsRuntime.InvokeAsync<bool>(
			"confirm", $"'{name}'을(를) 삭제할까요? 참조 중인 App이 있으면 자동으로 자체 소유 키로 전환됩니다.");
		if (!confirmed)
		{
			return;
		}

		try
		{
			var actorUserId = await GetCurrentUserIdAsync();
			await SharedSecretService.DeleteAsync(id, actorUserId);
			await ReloadAsync();
			Snackbar.Add("삭제했습니다.", Severity.Success);
		}
		catch (Exception ex)
		{
			Snackbar.Add($"삭제에 실패했습니다: {ex.Message}", Severity.Error);
		}
	}

}
