@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using S3EnvManager.Database
@using S3EnvManager.Database.Models
@using S3EnvManager.Web.Services
@using AppEntity = S3EnvManager.Database.Models.App

@inject ISharedSecretService SharedSecretService
@inject ApplicationDbContext Db
@inject ISnackbar Snackbar

<MudDialog>
	<DialogContent>
		<MudText Typo="Typo.body2" Class="mb-3">
			체크된 App만 이 공유 시크릿을 참조로 추가할 수 있습니다. 참조 권한을 해제하면 이미 그 App이
			가진 참조는 자동으로 자체 소유 키로 전환됩니다(값은 그대로 유지).
		</MudText>
		@if (_apps is null)
		{
			<MudProgressCircular Color="Color.Default" Indeterminate="true" />
		}
		else if (_apps.Count == 0)
		{
			<MudText Typo="Typo.body2">등록된 App이 없습니다.</MudText>
		}
		else
		{
			<MudList T="string">
				@foreach (var app in _apps)
				{
					<MudListItem T="string">
						<MudCheckBox T="bool" Value="@_grantedAppIds.Contains(app.Id)"
							ValueChanged="@(granted => ToggleAsync(app.Id, granted))"
							Label="@app.Name" />
					</MudListItem>
				}
			</MudList>
		}
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Close">닫기</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
	[CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

	[Parameter] public Guid SharedSecretId { get; set; }

	private List<AppEntity>? _apps;
	private HashSet<Guid> _grantedAppIds = [];

	protected override async Task OnInitializedAsync()
	{
		await ReloadAsync();
	}

	private async Task ReloadAsync()
	{
		_apps = await Db.Apps.AsNoTracking()
			.Where(a => a.DeletedAt == null)
			.OrderBy(a => a.Name)
			.ToListAsync();
		var grantedIds = await SharedSecretService.ListGrantedAppIdsAsync(SharedSecretId);
		_grantedAppIds = grantedIds.ToHashSet();
	}

	private async Task<string?> GetCurrentUserIdAsync()
	{
		if (AuthenticationStateTask is null)
		{
			return null;
		}
		var state = await AuthenticationStateTask;
		return state.User.FindFirstValue(ClaimTypes.NameIdentifier);
	}

	private async Task ToggleAsync(Guid appId, bool granted)
	{
		try
		{
			var actorUserId = await GetCurrentUserIdAsync();
			if (granted)
			{
				await SharedSecretService.GrantAsync(SharedSecretId, appId, actorUserId);
			}
			else
			{
				await SharedSecretService.RevokeGrantAsync(SharedSecretId, appId, actorUserId);
			}
			await ReloadAsync();
			Snackbar.Add("변경했습니다.", Severity.Success);
		}
		catch (Exception ex)
		{
			Snackbar.Add($"변경에 실패했습니다: {ex.Message}", Severity.Error);
		}
	}

	private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
