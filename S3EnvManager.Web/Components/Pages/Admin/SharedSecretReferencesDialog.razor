@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using S3EnvManager.Web.Services

@inject ISharedSecretService SharedSecretService
@inject ISnackbar Snackbar

<MudDialog>
	<DialogContent>
		<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
			<MudText Typo="Typo.body2">
				참조하는 모든 App/Env를 최신 값으로 강제 재동기화합니다(값 변경 없이도 실행 가능).
			</MudText>
			<MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ResyncAsync"
				Disabled="_resyncing">
				@(_resyncing ? "동기화 중..." : "지금 다시 동기화")
			</MudButton>
		</MudStack>

		@if (_lastResyncFailures is { Count: > 0 })
		{
			<MudAlert Severity="Severity.Warning" Class="mb-3">
				@(_lastResyncFailures.Count)개 Env 동기화 실패:
				@string.Join("; ", _lastResyncFailures.Select(f => $"{f.IsOverwriteBundle} {f.Reason}"))
			</MudAlert>
		}

		@if (_references is null)
		{
			<MudProgressCircular Color="Color.Default" Indeterminate="true" />
		}
		else if (_references.Count == 0)
		{
			<MudText Typo="Typo.body2">아직 참조하는 App/Env가 없습니다.</MudText>
		}
		else
		{
			<MudTable Items="_references" Hover="true" Elevation="0" Dense="true">
				<HeaderContent>
					<MudTh>App</MudTh>
					<MudTh>Env</MudTh>
					<MudTh>키</MudTh>
					<MudTh>상태</MudTh>
				</HeaderContent>
				<RowTemplate>
					<MudTd DataLabel="App">@context.AppName</MudTd>
					<MudTd DataLabel="Env">
						@context.EnvName@(context.IsOverwriteBundle ? " (overwrite)" : "")
					</MudTd>
					<MudTd DataLabel="키">@context.KeyName</MudTd>
					<MudTd DataLabel="상태">
						@if (context.LastMaterializedAt < SharedSecretUpdatedAt)
						{
							<MudChip T="string" Size="Size.Small" Color="Color.Warning">뒤처짐</MudChip>
						}
						else
						{
							<MudChip T="string" Size="Size.Small" Color="Color.Success">동기화됨</MudChip>
						}
					</MudTd>
				</RowTemplate>
			</MudTable>
		}
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Close">닫기</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
	[CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

	[Parameter] public Guid SharedSecretId { get; set; }
	[Parameter] public DateTimeOffset SharedSecretUpdatedAt { get; set; }

	private List<SharedSecretReferenceInfo>? _references;
	private IReadOnlyList<SharedSecretCascadeFailure>? _lastResyncFailures;
	private bool _resyncing;

	protected override async Task OnInitializedAsync()
	{
		await ReloadAsync();
	}

	private async Task ReloadAsync()
	{
		_references = (await SharedSecretService.ListReferencesAsync(SharedSecretId)).ToList();
	}

	private async Task<string?> GetCurrentUserIdAsync()
	{
		if (AuthenticationStateTask is null)
		{
			return null;
		}
		var state = await AuthenticationStateTask;
		return state.User.FindFirstValue(ClaimTypes.NameIdentifier);
	}

	private async Task ResyncAsync()
	{
		_resyncing = true;
		try
		{
			var actorUserId = await GetCurrentUserIdAsync();
			var result = await SharedSecretService.ResyncAsync(SharedSecretId, actorUserId);
			_lastResyncFailures = result.Failures;
			await ReloadAsync();
			SharedSecretUpdatedAt = DateTimeOffset.UtcNow;
			var message = result.Failures.Count == 0 ? "모두 동기화했습니다." : $"{result.Failures.Count}건 실패했습니다.";
			Snackbar.Add(message, result.Failures.Count == 0 ? Severity.Success : Severity.Warning);
		}
		catch (Exception ex)
		{
			Snackbar.Add($"동기화에 실패했습니다: {ex.Message}", Severity.Error);
		}
		finally
		{
			_resyncing = false;
		}
	}

	private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
