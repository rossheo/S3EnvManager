@using Microsoft.AspNetCore.Identity
@using S3EnvManager.Database

@inject SignInManager<ApplicationUser> SignInManager

<MudNavMenu>
	<MudNavLink Href="Account/Manage"
				Match="NavLinkMatch.All"
				Icon="@Icons.Material.Filled.Person">Profile</MudNavLink>
	@* 이메일 변경은 확인 메일 링크로만 완료되는데 메일 발송기가 NoOp이라 끝낼 수 없다 - 실제
	   발송기를 붙이기 전까지 메뉴에서 뺀다(Login.razor의 비밀번호 찾기 링크와 같은 이유). *@
	<MudNavLink Href="Account/Manage/ChangePassword" Icon="@Icons.Material.Filled.Lock">Password</MudNavLink>
	@if (hasExternalLogins)
	{
		<MudNavLink Href="Account/Manage/ExternalLogins"
					Icon="@Icons.Material.Filled.PhoneLocked">External logins</MudNavLink>
	}
	<MudNavLink Href="Account/Manage/TwoFactorAuthentication"
				Icon="@Icons.Material.Filled.LockClock">Two-factor authentication</MudNavLink>
	<MudNavLink Href="Account/Manage/Passkeys" Icon="@Icons.Material.Filled.Password">Passkeys</MudNavLink>
	<MudNavLink Href="Account/Manage/Notifications"
				Icon="@Icons.Material.Filled.Notifications">Notifications</MudNavLink>
	<MudNavLink Href="Account/Manage/PersonalData"
				Icon="@Icons.Material.Filled.PersonRemove">Personal data</MudNavLink>
</MudNavMenu>

@code {
	private bool hasExternalLogins;

	protected override async Task OnInitializedAsync()
	{
		hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
	}
}
