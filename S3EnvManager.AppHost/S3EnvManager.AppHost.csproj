<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>f5e08a90-44f4-43d4-9a2d-4f767a694acc</UserSecretsId>
    <IsPackable>false</IsPackable>
    <!-- Aspire 13.6부터 AspireUseCliBundle=false(SDK 기본값)이면 ASPIRE010 경고가 항상 뜬다.
         DCP/대시보드는 계속 NuGet 패키지에서 가져오고 Aspire CLI 번들에 의존하지 않기로
         했으므로 경고를 억제한다. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AWS" />
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <!-- Aspire.Hosting.AWS가 물고 오는 Amazon.CDK.Lib의 취약 버전(GHSA-464c-974j-9xm6)을
         override하기 위한 명시적 참조 - Directory.Packages.props 참고. -->
    <PackageReference Include="Amazon.CDK.Lib" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\S3EnvManager.Web\S3EnvManager.Web.csproj" />
    <ProjectReference Include="..\S3EnvManager.Configuration.SampleApp\S3EnvManager.Configuration.SampleApp.csproj" />
    <ProjectReference Include="..\S3EnvManager.MigrationService\S3EnvManager.MigrationService.csproj" />
  </ItemGroup>

</Project>
